// ── Default parameters (mirrors config.yaml) ──────────────────────────────
params {
    // Sample list; leave empty [] to auto-discover */*.bam in bam_dir
    // Expected layout: bam_dir/SAMPLE/SAMPLE.bam
    samples          = []
    bam_dir          = "."
    resume_from_fasta = false
    fasta_dir        = "."
    stats_dir        = "."

    // Site tool locations. An env var wins; otherwise use the canonical
    // schzrnas path if it is readable, else the fangg03a copy. Expressed
    // inline because Nextflow's strict config parser rejects function defs.
    env_bin          = System.getenv('PIPELINE_ENV_BIN') ?: (new File('/sc/arion/projects/schzrnas/zhangy40/softwares/conda/env/myenv/bin').canRead() ? '/sc/arion/projects/schzrnas/zhangy40/softwares/conda/env/myenv/bin' : '/sc/arion/projects/fangg03a/zhangy40/long_read_microbiome/env/myenv/bin')
    tools_dir        = System.getenv('PIPELINE_TOOLS')   ?: (new File('/sc/arion/projects/schzrnas/zhangy40/softwares').canRead() ? '/sc/arion/projects/schzrnas/zhangy40/softwares' : '/sc/arion/projects/fangg03a/zhangy40/long_read_microbiome/bin')

    // Tool paths
    scriptsdir       = "${projectDir}/scripts"
    kraken_db        = "/sc/arion/projects/schzrnas/zhangy40/softwares/kuniq_microbialdb_minus_kdb.20230808"
    kraken_db_suppl  = "/sc/arion/projects/schzrnas/zhangy40/softwares/kuniq_supplemental_vf_db_v2"
    use_suppl_db     = true   // set false (--use_suppl_db false) to skip supplemental DB
    blastdb          = "/sc/arion/projects/schzrnas/zhangy40/softwares/blast_db/nt"
    // Was ~/.taxonkit (mode 0700, unreadable to anyone else); the project-space
    // copy is byte-identical (verified by cmp on all 4 .dmp files).
    taxonkit_data_dir = "/sc/arion/projects/schzrnas/zhangy40/softwares/taxdump"
    t2t_ref          = "/sc/arion/projects/schzrnas/zhangy40/ref/CHM13_T2T/chm13v2.0.mmi"

    // Optional path to a built .sif (see the singularity profile below)
    container_sif    = null

    // BLAST splitting
    blast_split_nseq = 5000

    // Output directory
    outdir           = "results"

    // LSF billing project
    // SLURM equivalents (used only by -profile slurm)
    slurm_partition  = System.getenv('SLURM_PARTITION') ?: null
    slurm_account    = System.getenv('SLURM_ACCOUNT') ?: null

    // LSF billing account. Members of another lab must override:
    //   --lsf_project acc_fangg03a   (or export LSF_ACCOUNT)
    lsf_project      = System.getenv('LSF_ACCOUNT') ?: "acc_schzrnas"

    // Scratch directory for I/O-heavy intermediate steps.
    // Override at runtime: --scratch_dir /other/path
    scratch_dir      = "/sc/arion/scratch/${System.getenv('USER')}"
}

// ── Per-process resource configuration (mirrors cluster.yaml) ─────────────
process {
    // Global defaults. Resources here are scheduler-AGNOSTIC (cpus/memory/time);
    // the executor and any scheduler-specific syntax live in the profiles below,
    // so this file is not tied to LSF. Select one with -profile lsf|slurm|local.
    time           = '6h'
    memory         = '8 GB'
    cpus           = 1
    // Mirror the Snakemake shell.prefix: load anaconda3 BEFORE export PATH so
    // miniforge3 does not prepend and override the myenv binaries.
    beforeScript   = "module load anaconda3 seqkit && export PATH=${params.env_bin}:${params.tools_dir}:\$PATH"

    // unmapped_analysis
    withName: 'UNMAPPED_ANALYSIS' {
        cpus           = 10
        memory         = '12 GB'
        time           = '4h'
    }

    // mapped_human_stats
    withName: 'MAPPED_HUMAN_STATS' {
        cpus           = 10
        memory         = '6 GB'
        time           = '6h'
    }

    // krakenuniq  – requires high-memory node
    withName: 'KRAKENUNIQ' {
        ext.himem      = true   // needs a select[himem] node on LSF
        cpus           = 4
        memory         = '180 GB'
        time           = '4h'
        maxForks       = 5
    }

    // supplemental krakenuniq — smaller DB (~47 GB on disk) needs less RAM than primary
    withName: 'KRAKENUNIQ_SUPPL' {
        ext.himem      = true   // needs a select[himem] node on LSF
        cpus           = 2
        memory         = '60 GB'
        time           = '4h'
        maxForks       = 5
    }

    withName: 'KRAKEN_PROCESS' {
        cpus           = 1
        memory         = '8 GB'
        time           = '1h'
        maxForks       = 20
    }

    withName: 'KRAKEN_PROCESS_SUPPL' {
        cpus           = 1
        memory         = '8 GB'
        time           = '1h'
        maxForks       = 20
    }

    withName: 'MERGE_KRAKEN' {
        cpus           = 1
        memory         = '8 GB'
        time           = '6h'
    }

    withName: 'SPLIT_BLAST_QUERY' {
        cpus           = 1
        memory         = '8 GB'
        time           = '6h'
        scratch        = { params.scratch_dir }
    }

    // megaBLAST per chunk – requires high-memory node
    withName: 'MEGABLAST_CHUNK' {
        ext.himem      = true   // needs a select[himem] node on LSF
        cpus           = 16
        memory         = '30 GB'
        time           = '12h'
        scratch        = { params.scratch_dir }
    }

    withName: 'MERGE_BLAST_CHUNKS' {
        cpus           = 1
        memory         = '8 GB'
        time           = '6h'
    }

    withName: 'PROCESS_BLAST' {
        cpus           = 16
        memory         = '30 GB'
        time           = '6h'
        queue          = 'express'
    }

    withName: 'ANNOTATE_BLAST_LENGTHS' {
        cpus           = 1
        memory         = '30 GB'
        time           = '6h'
    }

    withName: 'MEDIAN_LENGTH_ADJ' {
        cpus           = 1
        memory         = '8 GB'
        time           = '2h'
    }
}

// ── Execution profiles ────────────────────────────────────────────────────
profiles {
    // LSF (Mount Sinai Minerva and similar). All LSF-specific syntax is
    // confined here. rusage is derived from each process's `memory` directive,
    // which reproduces the previous hand-written per-process values exactly;
    // ext.himem adds the select[himem] constraint for the three processes that
    // need a high-memory node.
    lsf {
        process.executor = 'lsf'
        process.queue    = 'premium'
        process.clusterOptions = {
            def mem = task.memory.toMega().intValue()
            def sel = task.ext.himem ? "select[himem] " : ""
            "-P ${params.lsf_project} -R '${sel}rusage[mem=${mem}] span[hosts=1]'"
        }
    }

    // SLURM. Memory/cpus/time come from the portable directives above; adjust
    // the partition to match your site. UNTESTED -- no SLURM system was
    // available to validate this against; treat it as a starting point.
    slurm {
        process.executor = 'slurm'
        process.queue    = params.slurm_partition
        process.clusterOptions = {
            params.slurm_account ? "--account=${params.slurm_account}" : ""
        }
    }

    // Local execution for testing (single machine)
    local {
        process.executor = 'local'
        process.cpus     = 4
        process.memory   = '8 GB'
        process.queue    = null
    }

    // Singularity container (can be combined with lsf or local).
    // NOTE: pipeline.sif is NOT built or shipped, and nextflow/pipeline.def has
    // never been successfully built (its %post uses apt-get, which needs fakeroot;
    // Minerva users are not in /etc/subuid). It also pins no versions, so a build
    // would NOT reproduce the published environment (py 3.7.12 / pandas 1.3.5).
    // Build and validate against a known sample before trusting this profile.
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        process.container      = params.container_sif ?: 'pipeline.sif'
    }
}

// ── Nextflow execution settings ───────────────────────────────────────────
executor {
    // Max simultaneous jobs submitted to the scheduler
    queueSize = 200
}

// Keep intermediate files for debugging; remove for production runs
// cleanup = true
