configfile: "config.yaml"

import glob
import os

# ── Site path resolution ──────────────────────────────────────────────────
# Tool locations are resolved at parse time, in this order:
#   1. environment variable (PIPELINE_ENV_BIN / PIPELINE_TOOLS)
#   2. first readable candidate below
# This keeps runs reproducible for the schzrnas group while letting anyone
# without schzrnas access point at the fangg03a copy (or their own) instead.
def _resolve_site_path(env_var, candidates):
    override = os.environ.get(env_var)
    if override:
        return override
    for cand in candidates:
        if os.access(cand, os.R_OK | os.X_OK):
            return cand
    return candidates[0]

ENV_BIN = _resolve_site_path("PIPELINE_ENV_BIN", [
    "/sc/arion/projects/schzrnas/zhangy40/softwares/conda/env/myenv/bin",
    "/sc/arion/projects/fangg03a/zhangy40/long_read_microbiome/env/myenv/bin",
])
TOOLS_DIR = _resolve_site_path("PIPELINE_TOOLS", [
    "/sc/arion/projects/schzrnas/zhangy40/softwares",
    "/sc/arion/projects/fangg03a/zhangy40/long_read_microbiome/bin",
])

# Activate conda environment on every compute node before running shell commands.
# Load anaconda3 BEFORE the PATH export so miniforge3 cannot override myenv.
# `|| true` matters: on a system without Lmod (container, laptop, non-Minerva
# cluster) `module` does not exist, and an unguarded `&&` chain would fail every
# single rule. Where the modules are absent we simply rely on PATH.
# NOTE: no braces here — Snakemake runs .format() over shell commands, so a
# `{ ...; }` group would be parsed as a format field. `a || true && b` is
# left-associative in bash, i.e. `(a || true) && b`, which is what we want.
shell.prefix(
    "module load anaconda3 seqkit >/dev/null 2>&1 || true && "
    f"export PATH={ENV_BIN}:{TOOLS_DIR}:$PATH && "
)

# ── Validate required config up front ─────────────────────────────────────
# Report every missing/unreadable path at once, before any job is submitted.
# Without this an unset database surfaces as a "file not found" inside a job
# that has already waited in the queue.
def _validate_config():
    required = [
        ("kraken_db",         "KrakenUniq primary database directory"),
        ("blastdb",           "NCBI nt BLAST database prefix"),
        ("taxonkit_data_dir", "NCBI taxdump directory for taxonkit"),
        ("t2t_ref",           "minimap2 .mmi for the 2nd host-depletion pass"),
    ]
    if str(config.get("use_suppl_db", True)).lower() != "false":
        required.append(("kraken_db_suppl", "supplemental viral+fungal KrakenUniq DB"))

    problems = []
    for key, desc in required:
        val = config.get(key)
        if not val:
            problems.append(f"  {key}: not set — {desc}")
            continue
        # blastdb is a prefix (nt -> nt.00.nin, ...), not a path that exists
        probe = os.path.dirname(val) if key == "blastdb" else val
        if not os.access(probe, os.R_OK):
            problems.append(f"  {key}: not readable — {val}")

    if problems:
        raise WorkflowError(
            "Pipeline configuration is incomplete:\n"
            + "\n".join(problems)
            + "\n\nStart from snakemake/config.template.yaml and pass your copy with"
              "\n  --configfile /path/to/your.yaml"
              "\nIf the paths ARE set, you may simply lack read permission; run"
              "\n  bash check_env.sh"
        )

_validate_config()

os.makedirs("logs", exist_ok=True)

# Resolve use_suppl_db robustly — handles bool (from config.yaml) and
# string "false" (from --config use_suppl_db=false on the CLI).
USE_SUPPL_DB = str(config.get("use_suppl_db", True)).lower() != "false"

if config.get("samples"):
    SAMPLES = config["samples"]
else:
    # Discover samples from per-sample subdirs (BAM or unmapped FASTA inside subdir)
    bam_samples = sorted([
        os.path.basename(os.path.dirname(x))
        for x in glob.glob("*/*.bam")
        if "unmapp" not in os.path.basename(x) and "mm2" not in os.path.basename(x)
    ])
    fasta_samples = sorted([
        os.path.basename(os.path.dirname(x))
        for x in glob.glob("*/*.after_t2t.unmapped.fasta.gz")
    ])
    SAMPLES = bam_samples if bam_samples else fasta_samples

rule all:
    input:
        expand("{sample}/{sample}.median_l_adj.txt", sample=SAMPLES),
        expand("{sample}/{sample}.microbiome.sum_by_length_per_genus.txt", sample=SAMPLES),
        expand("{sample}/{sample}.human_median_length.tsv", sample=SAMPLES)

include: "rules/unmapped.smk"
include: "rules/samtools_stats.smk"
include: "rules/krakenuniq.smk"
include: "rules/krakenuniq_suppl.smk"
include: "rules/kraken_process.smk"
include: "rules/kraken_process_suppl.smk"
include: "rules/merge_kraken.smk"
include: "rules/blast.smk"
include: "rules/blast_process.smk"
include: "rules/median_length_adj.smk"
